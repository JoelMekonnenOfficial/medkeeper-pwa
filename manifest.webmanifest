{
  "name": "MedKeeper — Medication Tracker",
  "short_name": "MedKeeper",
  "description": "Privacy-first medication tracker. Doses, smart reminders, refills, and a doctor-ready report. Your data stays on this device.",
  "start_url": "./index.html",
  "scope": "./",
  "id": "/medkeeper/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#0b1220",
  "theme_color": "#2563EB",
  "lang": "en",
  "dir": "ltr",
  "categories": ["medical", "health", "lifestyle", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-72.png",  "sizes": "72x72",   "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-96.png",  "sizes": "96x96",   "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-128.png", "sizes": "128x128", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-144.png", "sizes": "144x144", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-152.png", "sizes": "152x152", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-384.png", "sizes": "384x384", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "screenshots/screen-1-today.png",     "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Today view with one-tap dose actions" },
    { "src": "screenshots/screen-2-add.png",       "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Add a medication with color and shape" },
    { "src": "screenshots/screen-3-schedule.png",  "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Four schedule types including tapers" },
    { "src": "screenshots/screen-4-adherence.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Adherence heatmap with day drill-down" },
    { "src": "screenshots/screen-5-export.png",    "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Doctor-ready printable report" }
  ],
  "shortcuts": [
    { "name": "Today",   "short_name": "Today",   "url": "./index.html#today",    "description": "Open today's doses" },
    { "name": "Add med", "short_name": "Add",     "url": "./index.html#add",      "description": "Add a new medication" },
    { "name": "Report",  "short_name": "Report",  "url": "./index.html#history",  "description": "Open the doctor report" }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
